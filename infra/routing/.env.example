# Copy to .env on the server (never commit .env).

# The server's public name; point a DNS A record at the server first.
ROUTING_DOMAIN=routing.blacktoplive.com

# Shared secret between place-search and this server: openssl rand -hex 32
# The same value goes in the ROUTING_TOKEN Supabase secret.
ROUTING_TOKEN=change-me

# Map data to route on (Geofabrik extract). Start with the region your riders
# are in; see README.md for sizes. Examples:
#   https://download.geofabrik.de/europe/great-britain-latest.osm.pbf
#   https://download.geofabrik.de/europe/britain-and-ireland-latest.osm.pbf
#   https://download.geofabrik.de/europe-latest.osm.pbf
REGION_PBF_URL=https://download.geofabrik.de/europe/britain-and-ireland-latest.osm.pbf

# Valhalla worker threads (about the number of CPU cores).
VALHALLA_THREADS=8

# Pin images here once it's working (e.g. a release tag instead of latest).
# OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:latest
# VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:latest
