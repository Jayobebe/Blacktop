# HTTPS (automatic certificate for ROUTING_DOMAIN) and the shared token.
# `route` keeps the directives in the order written: health, token check,
# then the two routers. Without it Caddy would run handle_path before the
# token check and the routers would be open to anyone.
{$ROUTING_DOMAIN} {
	encode gzip

	route {
		respond /health "ok" 200

		@noToken not header Authorization "Bearer {$ROUTING_TOKEN}"
		respond @noToken "unauthorized" 401

		handle_path /osrm/* {
			reverse_proxy osrm:5000
		}
		handle_path /valhalla/* {
			reverse_proxy valhalla:8002
		}

		respond "not found" 404
	}
}
