# HTTPS (automatic certificate for GEO_DOMAIN) and the shared token.
# `route` keeps the directives in the order written: health, token check,
# then the services. Without it Caddy would run handle_path before the token
# check and the services would be open to anyone.
{$GEO_DOMAIN} {
	encode gzip

	route {
		respond /health "ok" 200

		@noToken not header Authorization "Bearer {$GEO_TOKEN}"
		respond @noToken "unauthorized" 401

		handle_path /valhalla/* {
			reverse_proxy valhalla:8002
		}
		handle_path /osrm/* {
			reverse_proxy osrm:5000
		}
		handle_path /photon/* {
			reverse_proxy photon:2322
		}
		handle_path /overpass/* {
			reverse_proxy overpass:80
		}
		handle_path /weather/* {
			reverse_proxy weather:8080
		}

		respond "not found" 404
	}
}
