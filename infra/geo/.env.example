# Copy to .env on the server (never commit .env).

# The server's public name; point a DNS A record at the server first.
GEO_DOMAIN=geo.blacktoplive.com

# Shared secret between Blacktop's Edge Functions and this server:
#   openssl rand -hex 32
# The same value goes in the GEO_SERVER_TOKEN Supabase secret.
GEO_TOKEN=change-me

# --- Valhalla and OSRM (routing) ------------------------------------------------
# Map data to route on (build-valhalla.sh and build-osrm.sh). The whole world:
REGION_PBF_URL=https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf
# Or a region while testing, e.g.
#   https://download.geofabrik.de/europe/britain-and-ireland-latest.osm.pbf
# Worker threads (about the number of CPU cores).
VALHALLA_THREADS=16

# --- Photon (search) ----------------------------------------------------------
# The prebuilt search index (get-photon.sh). Must match the Photon version in
# photon/Dockerfile; see README.md.
PHOTON_DB_URL=https://download1.graphhopper.com/public/photon-db-latest.tar.bz2
PHOTON_JAVA_OPTS=-Xmx12g

# --- Overpass -----------------------------------------------------------------
# clone: copy the whole-world database from overpass-api.de (fastest start).
# init:  build from OVERPASS_PLANET_URL (a region or the planet) instead.
OVERPASS_MODE=clone
# OVERPASS_PLANET_URL=https://download.geofabrik.de/europe/britain-and-ireland-latest.osm.bz2
# OVERPASS_DIFF_URL=https://planet.openstreetmap.org/replication/minute/

# --- Open-Meteo (weather) -------------------------------------------------------
# One global model is enough for alerts. Blacktop's send-push asks for this model
# by name (OWN_WEATHER_MODEL in supabase/functions/send-push/events.ts).
WEATHER_MODEL=ecmwf_ifs025

# Pin images here once it's working (release tags instead of latest).
# OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:latest
# VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:latest
# OVERPASS_IMAGE=wiktorn/overpass-api:latest
# OPENMETEO_IMAGE=ghcr.io/open-meteo/open-meteo:latest
